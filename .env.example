# Movidesk
MOVIDESK_TOKEN=[TOKEN_MOVIDESK]
MOVIDESK_BASE_URL=https://api.movidesk.com/public/v1
MOVIDESK_TICKET_URL_TEMPLATE=[MOVIDESK_TICKET_URL_TEMPLATE]

# ClickUp
CLICKUP_TOKEN=[TOKEN_CLICKUP]
CLICKUP_BASE_URL=https://api.clickup.com/api/v2
CLICKUP_DEFAULT_LIST_ID=
CLICKUP_DEFAULT_LIST_NAME=
CLICKUP_TASK_STATUS=Open
CLICKUP_ASSIGNEE_IDS=
CLICKUP_ASSIGNEE_EMAIL=
CLICKUP_ASSIGN_AUTHORIZED_USER=true

# Regra opcional de elegibilidade por servico do Movidesk.
# Se ficar vazio, a API nao bloqueia por servico.
REQUIRED_SERVICE_FIRST_LEVEL=
REQUIRED_SERVICE_SECOND_LEVEL=
REQUIRED_SERVICE_THIRD_LEVEL=
REQUIRED_SERVICE_DISPLAY_NAME=

# Seguranca do webhook
WEBHOOK_SECRET=

# Banco de dados
DATABASE_URL=[DATABASE_URL]
POSTGRES_PASSWORD=[POSTGRES_PASSWORD]
TURSO_DATABASE_URL=[TURSO_DATABASE_URL]
TURSO_AUTH_TOKEN=[TURSO_AUTH_TOKEN]

# Aplicacao
APP_ENV=dev
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30

# Fase 1: manter false. Fase 2: habilitar somente depois de validar atualizacao no Movidesk.
ENABLE_MOVIDESK_UPDATE=false
MOVIDESK_SUCCESS_STATUS_VALUE=OK
