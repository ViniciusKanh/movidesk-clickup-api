# Movidesk
MOVIDESK_TOKEN=[TOKEN_MOVIDESK]
MOVIDESK_BASE_URL=https://api.movidesk.com/public/v1
MOVIDESK_TICKET_URL_TEMPLATE=[MOVIDESK_TICKET_URL_TEMPLATE]

# ClickUp
CLICKUP_TOKEN=[TOKEN_CLICKUP]
CLICKUP_BASE_URL=https://api.clickup.com/api/v2
CLICKUP_DEFAULT_LIST_ID=
CLICKUP_DEFAULT_LIST_NAME=
CLICKUP_TASK_STATUS=Pendente
CLICKUP_ASSIGNEE_IDS=
CLICKUP_ASSIGNEE_EMAIL=
CLICKUP_ASSIGN_AUTHORIZED_USER=true

# Regra opcional de elegibilidade por servico do Movidesk.
# Se ficar vazio, a API nao bloqueia por servico.
REQUIRED_SERVICE_FIRST_LEVEL=
REQUIRED_SERVICE_SECOND_LEVEL=
REQUIRED_SERVICE_THIRD_LEVEL=
REQUIRED_SERVICE_DISPLAY_NAME=

# Regra de elegibilidade por responsavel do Movidesk.
# Ordem de preferencia: ID > e-mail > nome (usa apenas o primeiro que estiver preenchido).
# Se todos ficarem vazios, a integracao NAO bloqueia por responsavel (compatibilidade retroativa).
MOVIDESK_REQUIRED_OWNER_ID=
MOVIDESK_REQUIRED_OWNER_EMAIL=[SEU_EMAIL_NO_MOVIDESK]
MOVIDESK_REQUIRED_OWNER_NAME=

# Seguranca do webhook (Movidesk -> API)
WEBHOOK_SECRET=[WEBHOOK_SECRET]

# Painel administrativo (/admin/ui). Deixe em branco para desabilitar o painel.
ADMIN_USERNAME=[ADMIN_USERNAME]
ADMIN_PASSWORD=[ADMIN_PASSWORD]
ADMIN_SESSION_SECRET=[ADMIN_SESSION_SECRET_ALEATORIO_E_LONGO]
ADMIN_SESSION_TTL_MINUTES=480

# Banco de dados
# Em producao (Vercel/serverless) use APENAS Turso (nao ha disco persistente para SQLite).
DATABASE_URL=sqlite:///./movidesk_clickup.db
POSTGRES_PASSWORD=[POSTGRES_PASSWORD]
TURSO_DATABASE_URL=[TURSO_DATABASE_URL]
TURSO_AUTH_TOKEN=[TURSO_AUTH_TOKEN]

# Aplicacao
APP_ENV=dev
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30

# Fase 1: manter false. Fase 2: habilitar somente depois de validar atualizacao no Movidesk.
ENABLE_MOVIDESK_UPDATE=false
MOVIDESK_SUCCESS_STATUS_VALUE=OK
